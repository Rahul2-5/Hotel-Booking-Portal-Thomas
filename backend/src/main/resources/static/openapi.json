{
  "openapi": "3.0.3",
  "info": {
    "title": "Hotel Booking Portal API",
    "version": "0.0.1",
    "description": "API documentation for the implemented hotel browsing and booking creation endpoints. No authentication is required. Dates are plain YYYY-MM-DD strings, interpreted as LocalDate on the server. A stay includes check-in and excludes checkout. Examples use invented guests and sample hotel data; availability changes as bookings are created. This document is served at /openapi.json."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Spring Boot backend"
    }
  ],
  "tags": [
    {
      "name": "Hotels",
      "description": "Browse hotels and view availability and backend-calculated stay totals."
    },
    {
      "name": "Bookings",
      "description": "Create one-room bookings."
    }
  ],
  "paths": {
    "/api/hotels": {
      "get": {
        "tags": [
          "Hotels"
        ],
        "summary": "Browse hotels or search by location",
        "operationId": "findHotels",
        "description": "All query parameters are optional, but checkIn and checkOut must be supplied together. Location matching is case-insensitive, supports partial matches, and ignores surrounding whitespace. A missing or blank location returns all hotels. No matching location returns an empty array. Results are ordered by hotel ID and include sold-out hotels. Without dates, checkIn, checkOut, nights, availableRooms and totalAmount are null. With valid dates, availability and totals are calculated for each room type.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Location"
          },
          {
            "$ref": "#/components/parameters/CheckIn"
          },
          {
            "$ref": "#/components/parameters/CheckOut"
          }
        ],
        "responses": {
          "200": {
            "description": "Hotels matching the location, including amenities and room types.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HotelResponse"
                  }
                },
                "examples": {
                  "withoutDates": {
                    "summary": "Browse without stay dates",
                    "value": [
                      {
                        "id": 4,
                        "name": "Hilltop Haven",
                        "location": "Manali",
                        "description": "Mountain-view rooms close to Mall Road.",
                        "amenities": [
                          "Free WiFi",
                          "Heater",
                          "Parking"
                        ],
                        "checkIn": null,
                        "checkOut": null,
                        "nights": null,
                        "roomTypes": [
                          {
                            "id": 4,
                            "name": "Deluxe Room",
                            "pricePerNight": 3800,
                            "totalRooms": 1,
                            "availableRooms": null,
                            "totalAmount": null
                          }
                        ]
                      }
                    ]
                  },
                  "withDates": {
                    "summary": "Two-night stay",
                    "value": [
                      {
                        "id": 4,
                        "name": "Hilltop Haven",
                        "location": "Manali",
                        "description": "Mountain-view rooms close to Mall Road.",
                        "amenities": [
                          "Free WiFi",
                          "Heater",
                          "Parking"
                        ],
                        "checkIn": "2026-12-20",
                        "checkOut": "2026-12-22",
                        "nights": 2,
                        "roomTypes": [
                          {
                            "id": 4,
                            "name": "Deluxe Room",
                            "pricePerNight": 3800,
                            "totalRooms": 1,
                            "availableRooms": 1,
                            "totalAmount": 7600
                          }
                        ]
                      }
                    ]
                  },
                  "noMatches": {
                    "summary": "No hotels match the location",
                    "value": []
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/hotels/{id}": {
      "get": {
        "tags": [
          "Hotels"
        ],
        "summary": "Get hotel details and optional stay availability",
        "operationId": "getHotel",
        "description": "Returns one hotel with amenities and room types. Dates must either both be omitted or both be provided. With dates, nights is checkout minus check-in, and each room type's totalAmount is nights multiplied by pricePerNight. Available rooms are totalRooms minus confirmed overlapping bookings. Two stays overlap when existing.checkIn < requested.checkOut AND existing.checkOut > requested.checkIn. Back-to-back stays do not overlap. Without dates, date-dependent fields are null. A sold-out hotel still returns HTTP 200 with availableRooms equal to zero.",
        "parameters": [
          {
            "$ref": "#/components/parameters/HotelId"
          },
          {
            "$ref": "#/components/parameters/CheckIn"
          },
          {
            "$ref": "#/components/parameters/CheckOut"
          }
        ],
        "responses": {
          "200": {
            "description": "Hotel details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HotelResponse"
                },
                "examples": {
                  "withDates": {
                    "value": {
                      "id": 4,
                      "name": "Hilltop Haven",
                      "location": "Manali",
                      "description": "Mountain-view rooms close to Mall Road.",
                      "amenities": [
                        "Free WiFi",
                        "Heater",
                        "Parking"
                      ],
                      "checkIn": "2026-12-20",
                      "checkOut": "2026-12-22",
                      "nights": 2,
                      "roomTypes": [
                        {
                          "id": 4,
                          "name": "Deluxe Room",
                          "pricePerNight": 3800,
                          "totalRooms": 1,
                          "availableRooms": 1,
                          "totalAmount": 7600
                        }
                      ]
                    }
                  },
                  "withoutDates": {
                    "value": {
                      "id": 4,
                      "name": "Hilltop Haven",
                      "location": "Manali",
                      "description": "Mountain-view rooms close to Mall Road.",
                      "amenities": [
                        "Free WiFi",
                        "Heater",
                        "Parking"
                      ],
                      "checkIn": null,
                      "checkOut": null,
                      "nights": null,
                      "roomTypes": [
                        {
                          "id": 4,
                          "name": "Deluxe Room",
                          "pricePerNight": 3800,
                          "totalRooms": 1,
                          "availableRooms": null,
                          "totalAmount": null
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/bookings": {
      "post": {
        "tags": [
          "Bookings"
        ],
        "summary": "Create a confirmed booking for one room",
        "operationId": "createBooking",
        "description": "Validates guest details and stay dates, locks the room-type row with PESSIMISTIC_WRITE, rechecks availability and saves the booking in one transaction. Booking attempts for the same room type wait for that lock before checking availability. The backend reads the nightly price from the database and calculates the total; price and total are not request fields. The price is stored on the booking so later room-price changes do not change the booking. Returns HTTP 409 if the stay is sold out. Totals above 99999999.99 are rejected with HTTP 400 because they cannot fit in the database column.",
        "requestBody": {
          "required": true,
          "description": "Room type, guest details and stay dates. Guest name and email are trimmed before validation.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookingRequest"
              },
              "examples": {
                "twoNightStay": {
                  "value": {
                    "roomTypeId": 4,
                    "guestName": "Sample Guest",
                    "guestEmail": "guest@example.com",
                    "checkIn": "2026-12-20",
                    "checkOut": "2026-12-22"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Booking saved. Includes its reference and backend-calculated total.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponse"
                },
                "examples": {
                  "confirmedBooking": {
                    "value": {
                      "bookingReference": "HB-A1B2C3D4E5F60718",
                      "hotelId": 4,
                      "hotelName": "Hilltop Haven",
                      "roomTypeId": 4,
                      "roomTypeName": "Deluxe Room",
                      "guestName": "Sample Guest",
                      "guestEmail": "guest@example.com",
                      "checkIn": "2026-12-20",
                      "checkOut": "2026-12-22",
                      "nights": 2,
                      "pricePerNight": 3800,
                      "totalAmount": 7600,
                      "status": "CONFIRMED"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "description": "The requested room type does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "examples": {
                  "roomTypeNotFound": {
                    "value": {
                      "status": 404,
                      "code": "NOT_FOUND",
                      "message": "Room type not found.",
                      "fieldErrors": {}
                    }
                  }
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/SoldOut"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Location": {
        "name": "location",
        "in": "query",
        "required": false,
        "description": "Case-insensitive partial location, for example mum for Mumbai.",
        "schema": {
          "type": "string"
        },
        "example": "Manali"
      },
      "CheckIn": {
        "name": "checkIn",
        "in": "query",
        "required": false,
        "description": "Check-in date in YYYY-MM-DD format. Cannot be before today according to the server date. Required if checkOut is provided.",
        "schema": {
          "type": "string",
          "format": "date",
          "example": "2026-12-20"
        }
      },
      "CheckOut": {
        "name": "checkOut",
        "in": "query",
        "required": false,
        "description": "Exclusive checkout date in YYYY-MM-DD format. Must be after checkIn. Required if checkIn is provided.",
        "schema": {
          "type": "string",
          "format": "date",
          "example": "2026-12-22"
        }
      },
      "HotelId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Hotel ID. An unknown ID returns HTTP 404.",
        "schema": {
          "type": "integer",
          "format": "int64"
        },
        "example": 4
      }
    },
    "schemas": {
      "HotelResponse": {
        "type": "object",
        "required": [
          "id",
          "name",
          "location",
          "description",
          "amenities",
          "checkIn",
          "checkOut",
          "nights",
          "roomTypes"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string",
            "maxLength": 150
          },
          "location": {
            "type": "string",
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "amenities": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 50
            }
          },
          "checkIn": {
            "type": "string",
            "format": "date",
            "example": "2026-12-20",
            "nullable": true
          },
          "checkOut": {
            "type": "string",
            "format": "date",
            "example": "2026-12-22",
            "nullable": true
          },
          "nights": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "nullable": true,
            "description": "Null without dates."
          },
          "roomTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoomTypeResponse"
            }
          }
        }
      },
      "RoomTypeResponse": {
        "type": "object",
        "required": [
          "id",
          "name",
          "pricePerNight",
          "totalRooms",
          "availableRooms",
          "totalAmount"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "pricePerNight": {
            "$ref": "#/components/schemas/Money"
          },
          "totalRooms": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "availableRooms": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "nullable": true,
            "description": "Null without dates. Zero means sold out for the selected stay."
          },
          "totalAmount": {
            "type": "number",
            "multipleOf": 0.01,
            "minimum": 0,
            "description": "Backend-calculated nights multiplied by pricePerNight. Null without dates.",
            "nullable": true
          }
        }
      },
      "CreateBookingRequest": {
        "type": "object",
        "required": [
          "roomTypeId",
          "guestName",
          "guestEmail",
          "checkIn",
          "checkOut"
        ],
        "properties": {
          "roomTypeId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "example": 4
          },
          "guestName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Required and must not be blank after trimming.",
            "example": "Sample Guest"
          },
          "guestEmail": {
            "type": "string",
            "format": "email",
            "minLength": 1,
            "maxLength": 150,
            "description": "Required valid email address. Surrounding whitespace is trimmed.",
            "example": "guest@example.com"
          },
          "checkIn": {
            "type": "string",
            "format": "date",
            "example": "2026-12-20",
            "description": "Required. Cannot be before today according to the server date."
          },
          "checkOut": {
            "type": "string",
            "format": "date",
            "example": "2026-12-22",
            "description": "Required. Must be after checkIn. The room is free for the next guest on this date."
          }
        }
      },
      "BookingResponse": {
        "type": "object",
        "required": [
          "bookingReference",
          "hotelId",
          "hotelName",
          "roomTypeId",
          "roomTypeName",
          "guestName",
          "guestEmail",
          "checkIn",
          "checkOut",
          "nights",
          "pricePerNight",
          "totalAmount",
          "status"
        ],
        "properties": {
          "bookingReference": {
            "type": "string",
            "maxLength": 20,
            "pattern": "^HB-[A-F0-9]{16}$",
            "description": "Server-generated reference. Existing candidates are retried, and a database UNIQUE constraint prevents duplicate stored references.",
            "example": "HB-A1B2C3D4E5F60718"
          },
          "hotelId": {
            "type": "integer",
            "format": "int64"
          },
          "hotelName": {
            "type": "string"
          },
          "roomTypeId": {
            "type": "integer",
            "format": "int64"
          },
          "roomTypeName": {
            "type": "string"
          },
          "guestName": {
            "type": "string",
            "maxLength": 100
          },
          "guestEmail": {
            "type": "string",
            "format": "email",
            "maxLength": 150
          },
          "checkIn": {
            "type": "string",
            "format": "date",
            "example": "2026-12-20"
          },
          "checkOut": {
            "type": "string",
            "format": "date",
            "example": "2026-12-22"
          },
          "nights": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "pricePerNight": {
            "$ref": "#/components/schemas/Money"
          },
          "totalAmount": {
            "type": "number",
            "multipleOf": 0.01,
            "minimum": 0,
            "description": "Amount calculated with BigDecimal on the backend, serialized as a JSON number.",
            "maximum": 99999999.99
          },
          "status": {
            "type": "string",
            "enum": [
              "CONFIRMED"
            ],
            "description": "A newly created booking is confirmed."
          }
        }
      },
      "Money": {
        "type": "number",
        "multipleOf": 0.01,
        "minimum": 0,
        "description": "Amount calculated with BigDecimal on the backend, serialized as a JSON number."
      },
      "ApiError": {
        "type": "object",
        "required": [
          "status",
          "code",
          "message",
          "fieldErrors"
        ],
        "properties": {
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string",
            "description": "Machine-readable error code, such as VALIDATION_ERROR, NOT_FOUND or SOLD_OUT."
          },
          "message": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Field names mapped to validation messages. Empty for errors without a field-specific message."
          }
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Invalid fields, missing paired dates, past check-in, checkout not after check-in, malformed dates or IDs, malformed JSON, or a booking total exceeding the database limit. Field-specific validation errors appear in fieldErrors; malformed JSON may have an empty fieldErrors object.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "examples": {
              "example": {
                "value": {
                  "status": 400,
                  "code": "VALIDATION_ERROR",
                  "message": "Please correct the invalid request fields.",
                  "fieldErrors": {
                    "checkOut": "Check-out must be after check-in."
                  }
                }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "The requested hotel does not exist.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "examples": {
              "example": {
                "value": {
                  "status": 404,
                  "code": "NOT_FOUND",
                  "message": "Hotel not found.",
                  "fieldErrors": {}
                }
              }
            }
          }
        }
      },
      "SoldOut": {
        "description": "No room is left for the selected stay.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "examples": {
              "example": {
                "value": {
                  "status": 409,
                  "code": "SOLD_OUT",
                  "message": "No rooms are available for the selected dates.",
                  "fieldErrors": {}
                }
              }
            }
          }
        }
      },
      "InternalError": {
        "description": "Unexpected server error. Internal exception details are not returned.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "examples": {
              "example": {
                "value": {
                  "status": 500,
                  "code": "INTERNAL_ERROR",
                  "message": "An unexpected error occurred.",
                  "fieldErrors": {}
                }
              }
            }
          }
        }
      }
    }
  }
}
